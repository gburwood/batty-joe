{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Handcrafted Level Definition",
  "description": "Schema for user-created and designer-crafted campaign levels in Batty Joe",
  "type": "object",
  "required": ["id", "title", "difficulty", "bricks", "metadata"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,32}$",
      "description": "Unique identifier for the level (e.g., 'user_level_5' or 'designer_campaign_01')"
    },
    "campaign_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Optional normal-campaign slot for a designer-authored level."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Display name for the level"
    },
    "description": {
      "type": "string",
      "maxLength": 256,
      "description": "Optional flavor text or design notes"
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "normal", "hard"],
      "description": "Intended difficulty level"
    },
    "bricks": {
      "type": "array",
      "minItems": 16,
      "maxItems": 96,
      "description": "Array of brick placements on the 12×10 grid",
      "items": {
        "type": "object",
        "required": ["col", "row", "type", "durability"],
        "properties": {
          "col": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11,
            "description": "Column (0-11)"
          },
          "row": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9,
            "description": "Row (0-9)"
          },
          "type": {
            "type": "string",
            "enum": ["standard", "indestructible", "powerup_spawner"],
            "description": "Brick type"
          },
          "durability": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Durability level (indestructible types ignore this)"
          },
          "powerup": {
            "type": "string",
            "enum": ["multi_ball", "laser", "slow_time", "paddle_expansion", "space_invaders_frenzy", "fps_frenzy", "pinball_frenzy", "asteroids_frenzy", "missile_command_frenzy", "arkanoid_revenge_frenzy", "grid_runner_frenzy"],
            "description": "Power-up type if type is 'powerup_spawner'."
          },
          "frenzyType": {
            "type": "string",
            "enum": ["invaders", "fps", "pinball", "asteroids", "missile_command", "arkanoid_revenge", "grid_runner"],
            "description": "Selected frenzy mode for a frenzy power-up."
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "required": ["created_at", "created_by"],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp"
        },
        "created_by": {
          "type": "string",
          "enum": ["player", "designer"],
          "description": "Creator type"
        },
        "last_modified_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string",
          "description": "Designer levels reference SpecForge version"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional labels (e.g., ['tutorial', 'challenging'])"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
